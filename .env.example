# ---- Server Config ----
PORT=5000

# ---- CORS: Set this to your Vercel frontend URL in Railway production ----
# Example: FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL=

# ---- Abuse protection ----
# Exact number of reverse proxies in front of Node (commonly 1 on Railway).
# Keep 0 when directly exposed; a wrong value can allow IP spoofing.
TRUST_PROXY_HOPS=0
HTTP_RATE_LIMIT_WINDOW_MS=900000
HTTP_RATE_LIMIT_MAX=100
TOKEN_RATE_LIMIT_WINDOW_MS=600000
TOKEN_RATE_LIMIT_MAX=10
AUTOMATION_RATE_LIMIT_WINDOW_MS=600000
AUTOMATION_RATE_LIMIT_MAX=5
SOCKET_CONNECTION_RATE_LIMIT_WINDOW_MS=600000
SOCKET_CONNECTION_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=300000
AI_RATE_LIMIT_MAX=15
TTS_RATE_LIMIT_WINDOW_MS=300000
TTS_RATE_LIMIT_MAX=10
RATE_LIMIT_MAX_KEYS=10000

# ---- AI / Speech APIs ----
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GROQ_API=
GOOGLE_TTS_API_KEY=
